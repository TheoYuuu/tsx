      "Docs/RELEASING.md",
      "Docs/USAGE.md",
      "Docs/Validation.md",
      "Docs/PUBLIC_REPOSITORY.md"
    ],
    "target_owned_directories": [
      ".githooks/",
      "Tools/Repository/"
    ],
    "excluded_source_directories": [
      "Private/",
      "Design/"
    ]
  }
}
